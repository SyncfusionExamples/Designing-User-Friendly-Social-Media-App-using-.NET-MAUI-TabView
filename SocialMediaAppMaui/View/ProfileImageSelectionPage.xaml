<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:listView="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             x:Class="SocialMediaAppMaui.ProfileImageSelectionPage"
             Title="Select Image">
    <VerticalStackLayout Padding="10" Spacing="10">
        <listView:SfListView x:Name="ImageListView"
                                SelectionMode="Single" AutoFitMode="Height"
                                ItemsSource="{Binding ImageList}">
            <listView:SfListView.ItemsLayout>
                <listView:GridLayout SpanCount="2" />
            </listView:SfListView.ItemsLayout>
            <listView:SfListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" Stroke="LightGray">
                        <Image Source="{Binding .}" HeightRequest="100" Aspect="AspectFill"/>
                    </Border>
                </DataTemplate>
            </listView:SfListView.ItemTemplate>
        </listView:SfListView>

        <Button Text="OK" WidthRequest="100"
                BackgroundColor="Blue"
                TextColor="White"
                Clicked="OnOkClicked"/>
    </VerticalStackLayout>

</ContentPage>