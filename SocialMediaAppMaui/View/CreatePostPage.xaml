<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             x:Class="SocialMediaAppMaui.CreatePostPage"
             Title="New Post">
    <VerticalStackLayout Spacing="20" Margin="20,0,20,0">
        <Label Text="Create a New Post" FontSize="20" />
        <Editor x:Name="captionEditor" Placeholder="Write something..." />
        <Image x:Name="postImage" IsVisible="False" HeightRequest="200" Aspect="AspectFill"/>
        <buttons:SfButton Text="Upload Image" ShowIcon="True"  WidthRequest="150"
                          Clicked="OnUploadImageClicked" TextColor="White" BackgroundColor="Blue" >
            <buttons:SfButton.ImageSource>
                <FontImageSource Glyph="&#xe787;" Color="White" FontFamily="MauiSampleFontIcon" Size="24"/>
            </buttons:SfButton.ImageSource>
        </buttons:SfButton>
        <buttons:SfButton Text="Publish Post" Clicked="OnPostClicked" TextColor="White" />
    </VerticalStackLayout>
</ContentPage>